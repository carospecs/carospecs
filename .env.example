# --- PartSnap environment variables ---
# Copy this file to .env.local and fill in the values from your Supabase project.
# .env.local is gitignored; never commit real keys.

# Browser-exposed (must be NEXT_PUBLIC_ prefixed for Next.js).
# These map to the spec's SUPABASE_URL / SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER expose to the browser. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only — used in Step 3 (GPT-4o Vision) and Step 6 (admin alerts).
OPENAI_API_KEY=
ADMIN_EMAIL=
